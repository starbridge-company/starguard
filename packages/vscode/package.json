{
  "name": "starguard-vscode",
  "displayName": "StarGuard",
  "description": "Análise de segurança no editor com a sua conta StarGuard: código, dependências, regras de negócio e skills — cada uma por conta própria, com correção assistida. Requer conta da Starbridge.",
  "version": "0.2.3",
  "publisher": "starbridge",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "starguard.runAll",
        "title": "StarGuard: analisar tudo",
        "icon": "$(play)"
      },
      {
        "command": "starguard.runAnalyzer",
        "title": "StarGuard: analisar…",
        "icon": "$(play)"
      },
      {
        "command": "starguard.validateCurrentSkill",
        "title": "StarGuard: validar skills e prompts"
      },
      {
        "command": "starguard.fix",
        "title": "StarGuard: corrigir com IA"
      },
      {
        "command": "starguard.clear",
        "title": "StarGuard: limpar os achados",
        "icon": "$(clear-all)"
      },
      {
        "command": "starguard.doctor",
        "title": "StarGuard: diagnóstico"
      },
      {
        "command": "starguard.signIn",
        "title": "StarGuard: entrar na conta"
      },
      {
        "command": "starguard.signOut",
        "title": "StarGuard: sair da conta"
      },
      {
        "command": "starguard.requestAccess",
        "title": "StarGuard: solicitar acesso"
      },
      {
        "command": "starguard.enableAccountAi",
        "title": "StarGuard: usar a IA da minha conta"
      },
      {
        "command": "starguard.configurarCaminhos",
        "title": "StarGuard: configurar o caminho dos scanners"
      },
      {
        "command": "starguard.openPullRequest",
        "title": "StarGuard: abrir Pull Request com as correções"
      }
    ],
    "views": {
      "starguard": [
        {
          "type": "webview",
          "id": "starguard.painel",
          "name": "StarGuard"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "starguard.clear",
          "when": "view == starguard.painel && starguard.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "starguard.doctor",
          "when": "view == starguard.painel"
        }
      ]
    },
    "configuration": {
      "title": "StarGuard",
      "properties": {
        "starguard.analyzers.enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "threat",
              "sast",
              "sca",
              "business",
              "skills"
            ]
          },
          "default": [
            "sast",
            "sca"
          ],
          "markdownDescription": "Analisadores marcados por padrão ao abrir o painel. O padrão traz os dois que não custam IA; os outros continuam disponíveis com um clique no cartão."
        },
        "starguard.semgrepPath": {
          "type": "string",
          "default": "",
          "description": "Opcional. Caminho do Opengrep/Semgrep local — só é usado sem conta conectada; com conta, o scan roda no servidor e nada precisa estar instalado."
        },
        "starguard.trivyPath": {
          "type": "string",
          "default": "",
          "description": "Opcional. Caminho do Trivy local — só é usado sem conta conectada; com conta, o scan roda no servidor e nada precisa estar instalado."
        },
        "starguard.locale": {
          "type": "string",
          "enum": [
            "pt-BR",
            "en",
            "es"
          ],
          "default": "pt-BR",
          "description": "Idioma dos achados e das explicações."
        },
        "starguard.systemDescription": {
          "type": "string",
          "default": "",
          "markdownDescription": "Descrição do sistema usada por **regras de negócio** e **modelagem de ameaças**. Dá para escrevê-la direto no painel lateral, que é onde ela faz sentido."
        },
        "starguard.server": {
          "type": "string",
          "default": "https://starguard-31l1.onrender.com",
          "markdownDescription": "Servidor do StarGuard usado para autenticar. Troque apenas se sua equipe hospeda a própria instância."
        },
        "starguard.requestAccessUrl": {
          "type": "string",
          "default": "https://starguard-31l1.onrender.com/login",
          "description": "Página para onde 'Solicitar acesso' leva quem ainda não tem conta."
        },
        "starguard.sastRules": {
          "type": "string",
          "default": "",
          "markdownDescription": "Diretório de regras do Opengrep/Semgrep. Vazio usa `auto`, que BAIXA o ruleset de semgrep.dev a cada análise — o que falha em máquina sem saída para a internet ou atrás de proxy com CA própria. Aponte para uma cópia local para rodar offline."
        }
      }
    },
    "authentication": [
      {
        "id": "starguard",
        "label": "StarGuard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "starguard",
          "title": "StarGuard",
          "icon": "media/starguard.svg"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs --producao",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "build:dev": "node build.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies -o starguard.vsix",
    "install:local": "npm run package && node scripts/instalar-local.mjs",
    "publish:marketplace": "vsce publish --no-dependencies",
    "icon": "node scripts/gerar-icone.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0",
    "@starguard/core": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/starbridge-org/starguard",
    "directory": "packages/vscode"
  },
  "keywords": [
    "security",
    "sast",
    "sca",
    "semgrep",
    "trivy",
    "appsec",
    "cwe"
  ],
  "galleryBanner": {
    "color": "#141a17",
    "theme": "dark"
  },
  "icon": "icon.png",
  "bugs": {
    "url": "https://github.com/starbridge-org/starguard/issues"
  },
  "homepage": "https://github.com/starbridge-org/starguard#readme"
}
