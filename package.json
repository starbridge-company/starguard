{
  "name": "starguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "//engines": "O npm 10 do Node 22 resolve a árvore de dependências de forma diferente do 11 e RECUSA este package-lock.json (Missing: esbuild@0.28.1). O lock é artefato do npm 11; a CI e o Dockerfile fixam essa major. Declarar aqui faz o aviso aparecer ANTES do erro críptico do npm ci.",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "setup": "node scripts/gen-keys.mjs",
    "predev": "node scripts/gen-keys.mjs",
    "dev": "next dev",
    "build": "next build",
    "prestart": "node scripts/gen-keys.mjs && node scripts/check-schema.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run build:core && npm run typecheck --workspaces --if-present",
    "build:core": "npm run build -w @starguard/core",
    "gen:keys": "node scripts/gen-keys.mjs --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node scripts/migrate.mjs",
    "db:doctor": "node scripts/db-doctor.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "drizzle-kit migrate && node scripts/seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node e2e/run.mjs",
    "test:live": "vitest run --config vitest.live.mjs",
    "db:backfill-findings": "node scripts/backfill-findings.mjs",
    "build:packages": "npm run build -w @starguard/core && npm run build -w @starguard/cli && npm run build -w starguard-vscode",
    "cli": "node packages/cli/bin/starguard.mjs",
    "package:vscode": "npm run build:packages && npm run package -w starguard-vscode",
    "check:github-app": "node scripts/check-github-app.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "argon2": "^0.45.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "next": "^16.2.6",
    "octokit": "^5.0.5",
    "pg": "^8.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "playwright": "^1.50.0"
  }
}
