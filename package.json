{
  "name": "starguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/gen-keys.mjs",
    "predev": "node scripts/gen-keys.mjs",
    "dev": "next dev",
    "build": "next build",
    "prestart": "node scripts/gen-keys.mjs",
    "start": "next start",
