# ============================================================
# StarGuard — variáveis de ambiente (exemplo)
# Copie para .env.local e ajuste. NUNCA versione .env.local.
# ============================================================

# ---- Chaves de IA (headless por etapa) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Token do GitHub do SERVIDOR. Só é usado em nome do usuário quando
# SINGLE_TENANT=true (instância de dono único). Num deploy com várias contas,
# usá-lo como fallback deixaria qualquer usuário ler — e abrir PR em — todo
# repositório privado ao qual este token tem acesso. Ver AUDITORIA.md#SEC-06.
GITHUB_TOKEN=
SINGLE_TENANT=false            # true = instância de dono único

# ---- Provider/modelo default ----
AI_PROVIDER=anthropic          # anthropic | openai | google
AI_MODEL=claude-sonnet-5       # id de modelo ATUAL

# ---- Override de IA por etapa (headless por step) ----
STEP1_PROVIDER=anthropic
STEP1_MODEL=claude-sonnet-5
STEP2_PROVIDER=anthropic
STEP2_MODEL=claude-sonnet-5
STEP4_PROVIDER=anthropic
STEP4_MODEL=claude-sonnet-5

# ---- Orçamento de saída da IA (ajuste de operação, sem controle na tela) ----
# Modelos com "extended thinking" gastam ESTE mesmo teto raciocinando antes de
# escrever: uma descrição de sistema longa aumenta o pensamento e o JSON volta
# cortado, derrubando a fase. Se isso acontecer, suba o teto da etapa.
# A camada de IA ainda tenta UMA vez sozinha com o dobro, limitada por
# AI_MAX_OUTPUT_TOKENS. Ver AUDITORIA.md#BUG-13.
# STEP1_MAX_TOKENS=16000     # modelagem de ameaças
# STEP2_MAX_TOKENS=8000      # validação de skills
# STEP3_MAX_TOKENS=16000     # revisão por IA
# STEP4_MAX_TOKENS=16000     # correção de código
# AI_MAX_OUTPUT_TOKENS=32000 # teto absoluto do retry automático
# AI_TIMEOUT_MS=120000       # teto de tempo por chamada (fases curtas)
# AI_TIMEOUT_LONG_MS=280000  # scan e correção: devolvem arquivo inteiro e
#                            # levam minutos. Fica ABAIXO do maxDuration=300
#                            # da rota — acima disso o Next corta antes.
# AI_MAX_RETRIES=2           # retentativas em 429/5xx

# ---- Observabilidade ----
# LOG_FORMAT=json            # json em produção; texto legível em dev
# LOG_LEVEL=info             # debug | info | warn | error

# ---- Verificação de schema na subida ----
# Recusa subir em produção se faltarem migrações — sem isso, o app sobe e o
# login responde 500 para qualquer senha. Ver AUDITORIA.md#ARQ-12.
# SCHEMA_CHECK=off           # desliga a checagem (não recomendado)

# ---- Engines de segurança (headless por etapa) ----
SAST_ENGINE=opengrep           # opengrep | semgrep | none
SCA_ENGINE=trivy               # trivy | none
DAST_ENGINE=none               # none | zap(futuro)

# ---- Engine da Fase 4 (Correção) ----
# agent (padrão) -> via principal: agente autônomo (Claude Agent SDK) que clona o
#          repo, LÊ o repositório e EDITA os arquivos (Read/Edit apenas — sem
#          execução de comandos). Exige ANTHROPIC_API_KEY.
# api   -> disparo único na Claude API (busca o arquivo inteiro e devolve corrigido).
# A API entra como fallback SILENCIOSO se o agente falhar (sem key/rede/timeout).
FIX_ENGINE=agent               # agent | api
# FIX_AGENT_MODEL=             # default: modelo da etapa refactor (STEP4_MODEL/AI_MODEL)
# FIX_AGENT_MAX_TURNS=24       # teto de passos do agente
# FIX_AGENT_BUDGET_USD=1       # teto de custo por correção
# FIX_AGENT_TIMEOUT_MS=270000  # teto de tempo de parede (< maxDuration da rota)

# Caminhos opcionais para binários (default: usa o nome no PATH)
# SEMGREP_BIN=semgrep
# OPENGREP_BIN=opengrep
# TRIVY_BIN=trivy

# ---- O tamanho da caixa e os tetos de tempo do scan ----
#
# NÃO ponha SAST_JOBS/SCAN_SLOTS num servidor dedicado: sem eles, o código lê
# CPU e RAM do cgroup; sem cota Docker, usa a RAM física do host. A concorrência
# considera scans × filhos do Opengrep, reservando metade da memória para Node,
# JSON e sistema. Confira a procedência em GET /api/health → scan.box.
# SAST_JOBS=1                  # processos do opengrep
# SCAN_SLOTS=1                 # scanners simultâneos na máquina
# SAST_MAX_MEMORY_MB=200       # teto por processo do opengrep
# NODE_OPTIONS=--max-old-space-size=1280  # recomendado no servidor atual de 4 GB
#
# Os tetos de tempo TÊM DE CABER o que SCAN_MAX_FILES autoriza. Eram 300 s
# fixos no código, contra 800 arquivos por scan — que em meia CPU levam ~17 min.
# O teto de arquivos autorizava um trabalho que o teto de tempo proibia, e o
# desfecho chegava à tela como "Command failed: opengrep --config …".
# SAST_TIMEOUT_MS=900000       # 15 min — o mesmo prazo que o cliente espera
# SCA_TIMEOUT_MS=900000
# SCAN_MAX_FILES=800           # baixar isto é a alavanca quando não há CPU a dar
# SCAN_MAX_BYTES=8388608
# SCAN_JOB_IDLE_MS=            # silêncio até dar o job por abandonado. O padrão
#                              # deriva da tolerância do CLIENTE; abaixo dela, o
#                              # servidor recolhe scans que estão sendo seguidos
# SCAN_JOB_TTL_MS=120000       # fallback; clientes novos liberam ao consumir
#
# O RESULTADO do scanner é a única coisa deste caminho cujo tamanho não se
# conhece de antemão (a entrada tem SCAN_MAX_BYTES). Ele vem por ARQUIVO, e o
# tamanho é conferido ANTES do JSON.parse — que no V8 custa 3 a 4× o arquivo
# (string UTF-16 + grafo de objetos), tudo vivo ao mesmo tempo.
# SCAN_MAX_OUTPUT_MB=          # padrão: 5% da memória do contêiner, entre 8 e 64
# SCAN_MAX_FINDINGS=5000       # acima disso ficam os mais graves, e o corte é DITO

# ============================================================
# Banco de dados (Postgres — obrigatório)
# ============================================================
# TUDO vive no schema "starguard". Fluxo:
#   1) defina DATABASE_URL aqui
#   2) npm run db:migrate   (cria schema + tabelas)
#   3) npm run db:seed      (usuários demo: superadmin + admin)
#   (atalho: npm run db:setup faz 2+3)
DATABASE_URL=postgres://user:senha@localhost:5432/starguard
# PG_POOL_MAX=10
#
# Não conecta? `npm run db:doctor` (ou, no servidor,
# `docker exec -it <container> node scripts/db-doctor.mjs`) responde camada a
# camada — DNS, TCP, handshake, schema — e diz qual delas quebrou. O `pg`
# reporta as quatro com a MESMA frase: "Connection terminated".
# DB_DOCTOR_TIMEOUT_MS=5000
#
# Dentro de um contêiner, `localhost` é o próprio contêiner — nunca o host nem
# outro serviço. Ver DEPLOY.md.

# ============================================================
# Segurança / Auth (obrigatório)
# ============================================================

# JWT assimétrico (RS256). Gere com: npm run setup  (grava em .env.local).
# Pode ser PEM literal OU base64 do PEM (auto-detectado). NUNCA versionar.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Chave AES-256-GCM (base64 de 32 bytes) que cifra os tokens do GitHub no BD.
# Gerada automaticamente por `npm run setup` se ausente. NUNCA versionar.
TOKEN_ENC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=starguard
JWT_AUDIENCE=starguard-web

# Argon2id (params mínimos recomendados)
ARGON_MEMORY_KIB=19456     # ~19 MB
ARGON_ITERATIONS=3
ARGON_PARALLELISM=1

# ---- Usuários iniciais (seed idempotente; hash Argon2id derivado em runtime) ----
# Superadmin (vê tudo de todos):
SEED_SUPERADMIN_EMAIL=admin@starguard.local
SEED_SUPERADMIN_PASSWORD=StarGuard!2026
# Admin comum (vê apenas o próprio histórico):
SEED_ADMIN_EMAIL=membro@starguard.local
SEED_ADMIN_PASSWORD=StarGuard!2026

# ---- Rate limit ----
RATE_LIMIT_REDIS_URL=      # Redis/Upstash em prod; memória no MVP
# Cobrado APENAS em tentativa falha; login bem-sucedido zera o balde.
LOGIN_RATE_LIMIT=10/10m    # falhas por conta+IP
LOGIN_IP_RATE_LIMIT=30/10m # falhas por IP (freia enumeração de contas)
API_RATE_LIMIT=100/1m      # global por IP (login e /api/status são isentos)

# Quantos proxies confiáveis existem à frente da app. O IP do cliente é lido
# da DIREITA do X-Forwarded-For — a entrada da esquerda é fornecida pelo
# cliente e permitiria burlar o rate limit (ou trancar outra pessoa fora).
# Render/Vercel/Cloudflare = 1. Sem proxy nenhum (localhost direto) = 0.
TRUSTED_PROXY_HOPS=1

# Sal para pseudonimizar o IP na trilha de auditoria (LGPD: nunca gravamos o
# IP em claro). Se vazio, usa o COOKIE_SECRET. Trocar invalida a correlação
# de eventos antigos, mas não quebra nada.
AUDIT_IP_SALT=

# ---- Cookies/sessão ----
COOKIE_SECRET=             # gerado por npm run setup se vazio
SESSION_SECURE=true        # Secure + httpOnly + SameSite=Strict (use false em http local)

# ============================================================
# OAuth de cliente público (extensão do VS Code e CLI) — AUDITORIA.md#SEC-10
# ============================================================
# Vida do refresh token dos CLIENTES. Mais longo que o do navegador porque o
# editor não é reaberto todo dia — e o que limita o estrago de um token roubado
# não é o TTL, é a rotação com detecção de reuso.
OAUTH_REFRESH_TTL=30d

# Cota da rota de token, por cliente + IP. Mais apertada que a da API em geral:
# cada tentativa aqui é um palpite contra credencial, e o código de autorização
# vive 60 segundos — força bruta dentro dessa janela é o ataque óbvio.
OAUTH_TOKEN_RATE_LIMIT=20/1m

# ============================================================
# IA pela conta (SEC-11)
# ============================================================
# Teto de gasto por conta, por mês. É o que transforma "quanto vai custar?"
# numa pergunta com resposta: com pre-commit, PR e push disparando análise, um
# repositório ativo gera dezenas de execuções por dia.
AI_MONTHLY_BUDGET_USD=50

# ============================================================
# Fila de jobs (ARQ-04)
# ============================================================
# `off` desliga o worker embutido — é o que se usa quando ele roda num
# processo separado, para o servidor web não competir pela fila.
# QUEUE_WORKER=off
QUEUE_POLL_MS=5000
# Sem terminar neste tempo, o job é dado como abandonado e volta à fila. É o
# que impede um deploy no meio do trabalho de travar a fila para sempre.
QUEUE_LOCK_STALE_MS=900000
# Teto da espera quando o BANCO não responde. Sem backoff, o laço mantinha a
# cadência de fila vazia contra um banco fora do ar: 240 entradas de log por
# hora, cada uma com vinte linhas de SQL, escondendo todo o resto — inclusive o
# aviso da subida que explica o problema. Ver lib/worker.ts.
QUEUE_BACKOFF_MAX_MS=60000

# ============================================================
# GitHub App — gatilhos automáticos (SEC-12)
# ============================================================
# Sem estes três, /api/github/webhook responde 503 e os gatilhos não existem.
# A chave privada é o segredo MAIS SENSÍVEL do produto: com ela se forja acesso
# a todo repositório onde o App está instalado. Só em variável de ambiente,
# nunca no banco, nunca em log.
GITHUB_APP_ID=
# Quatro formas aceitas: PEM completo, PEM com `
` literais, o PEM inteiro em
# base64, ou só o miolo (o base64 do DER, sem as linhas BEGIN/END). Esta última
# é a que mais aparece na prática e a que dava erro antes.
GITHUB_APP_PRIVATE_KEY=
# Alternativa MENOS sujeita a erro: aponte para o .pem baixado e não cole nada.
# GITHUB_APP_PRIVATE_KEY_FILE=C:/caminho/starguard.private-key.pem
GITHUB_WEBHOOK_SECRET=

# Quantas correções o webhook propõe por execução, e a partir de qual
# severidade. Os dois são freio de CUSTO e de REVISÃO: um PR com quarenta
# correções de IA não é revisado, é aprovado no escuro ou ignorado.
WEBHOOK_MAX_FIXES=5
WEBHOOK_MIN_SEVERITY=high
