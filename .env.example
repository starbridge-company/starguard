# ============================================================
# StarGuard — variáveis de ambiente (exemplo)
# Copie para .env.local e ajuste. NUNCA versione .env.local.
# ============================================================

# ---- Chaves de IA (headless por etapa) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Token do GitHub do SERVIDOR. Só é usado em nome do usuário quando
# SINGLE_TENANT=true (instância de dono único). Num deploy com várias contas,
# usá-lo como fallback deixaria qualquer usuário ler — e abrir PR em — todo
# repositório privado ao qual este token tem acesso. Ver AUDITORIA.md#SEC-06.
GITHUB_TOKEN=
SINGLE_TENANT=false            # true = instância de dono único

# ---- Provider/modelo default ----
AI_PROVIDER=anthropic          # anthropic | openai | google
AI_MODEL=claude-sonnet-5       # id de modelo ATUAL

# ---- Override de IA por etapa (headless por step) ----
STEP1_PROVIDER=anthropic
STEP1_MODEL=claude-sonnet-5
STEP2_PROVIDER=anthropic
STEP2_MODEL=claude-sonnet-5
STEP4_PROVIDER=anthropic
STEP4_MODEL=claude-sonnet-5

# ---- Orçamento de saída da IA (ajuste de operação, sem controle na tela) ----
# Modelos com "extended thinking" gastam ESTE mesmo teto raciocinando antes de
# escrever: uma descrição de sistema longa aumenta o pensamento e o JSON volta
# cortado, derrubando a fase. Se isso acontecer, suba o teto da etapa.
# A camada de IA ainda tenta UMA vez sozinha com o dobro, limitada por
# AI_MAX_OUTPUT_TOKENS. Ver AUDITORIA.md#BUG-13.
# STEP1_MAX_TOKENS=16000     # modelagem de ameaças
# STEP2_MAX_TOKENS=8000      # validação de skills
# STEP3_MAX_TOKENS=16000     # revisão por IA
# STEP4_MAX_TOKENS=16000     # correção de código
# AI_MAX_OUTPUT_TOKENS=32000 # teto absoluto do retry automático
# AI_TIMEOUT_MS=120000       # teto de tempo por chamada (fases curtas)
# AI_TIMEOUT_LONG_MS=280000  # scan e correção: devolvem arquivo inteiro e
#                            # levam minutos. Fica ABAIXO do maxDuration=300
#                            # da rota — acima disso o Next corta antes.
# AI_MAX_RETRIES=2           # retentativas em 429/5xx

# ---- Observabilidade ----
# LOG_FORMAT=json            # json em produção; texto legível em dev
# LOG_LEVEL=info             # debug | info | warn | error

# ---- Verificação de schema na subida ----
# Recusa subir em produção se faltarem migrações — sem isso, o app sobe e o
# login responde 500 para qualquer senha. Ver AUDITORIA.md#ARQ-12.
# SCHEMA_CHECK=off           # desliga a checagem (não recomendado)

# ---- Engines de segurança (headless por etapa) ----
SAST_ENGINE=opengrep           # opengrep | semgrep | none
SCA_ENGINE=trivy               # trivy | none
DAST_ENGINE=none               # none | zap(futuro)

# ---- Engine da Fase 4 (Correção) ----
# agent (padrão) -> via principal: agente autônomo (Claude Agent SDK) que clona o
#          repo, LÊ o repositório e EDITA os arquivos (Read/Edit apenas — sem
#          execução de comandos). Exige ANTHROPIC_API_KEY.
# api   -> disparo único na Claude API (busca o arquivo inteiro e devolve corrigido).
# A API entra como fallback SILENCIOSO se o agente falhar (sem key/rede/timeout).
FIX_ENGINE=agent               # agent | api
# FIX_AGENT_MODEL=             # default: modelo da etapa refactor (STEP4_MODEL/AI_MODEL)
# FIX_AGENT_MAX_TURNS=24       # teto de passos do agente
# FIX_AGENT_BUDGET_USD=1       # teto de custo por correção
# FIX_AGENT_TIMEOUT_MS=270000  # teto de tempo de parede (< maxDuration da rota)

# Caminhos opcionais para binários (default: usa o nome no PATH)
# SEMGREP_BIN=semgrep
# OPENGREP_BIN=opengrep
# TRIVY_BIN=trivy

# ============================================================
# Banco de dados (Postgres — obrigatório)
# ============================================================
# TUDO vive no schema "starguard". Fluxo:
#   1) defina DATABASE_URL aqui
#   2) npm run db:migrate   (cria schema + tabelas)
#   3) npm run db:seed      (usuários demo: superadmin + admin)
#   (atalho: npm run db:setup faz 2+3)
DATABASE_URL=postgres://user:senha@localhost:5432/starguard
# PG_POOL_MAX=10

# ============================================================
# Segurança / Auth (obrigatório)
# ============================================================

# JWT assimétrico (RS256). Gere com: npm run setup  (grava em .env.local).
# Pode ser PEM literal OU base64 do PEM (auto-detectado). NUNCA versionar.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Chave AES-256-GCM (base64 de 32 bytes) que cifra os tokens do GitHub no BD.
# Gerada automaticamente por `npm run setup` se ausente. NUNCA versionar.
TOKEN_ENC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=starguard
JWT_AUDIENCE=starguard-web

# Argon2id (params mínimos recomendados)
ARGON_MEMORY_KIB=19456     # ~19 MB
ARGON_ITERATIONS=3
ARGON_PARALLELISM=1

# ---- Usuários iniciais (seed idempotente; hash Argon2id derivado em runtime) ----
# Superadmin (vê tudo de todos):
SEED_SUPERADMIN_EMAIL=admin@starguard.local
SEED_SUPERADMIN_PASSWORD=StarGuard!2026
# Admin comum (vê apenas o próprio histórico):
SEED_ADMIN_EMAIL=membro@starguard.local
SEED_ADMIN_PASSWORD=StarGuard!2026

# ---- Rate limit ----
RATE_LIMIT_REDIS_URL=      # Redis/Upstash em prod; memória no MVP
# Cobrado APENAS em tentativa falha; login bem-sucedido zera o balde.
LOGIN_RATE_LIMIT=10/10m    # falhas por conta+IP
LOGIN_IP_RATE_LIMIT=30/10m # falhas por IP (freia enumeração de contas)
API_RATE_LIMIT=100/1m      # global por IP (login e /api/status são isentos)

# Quantos proxies confiáveis existem à frente da app. O IP do cliente é lido
# da DIREITA do X-Forwarded-For — a entrada da esquerda é fornecida pelo
# cliente e permitiria burlar o rate limit (ou trancar outra pessoa fora).
# Render/Vercel/Cloudflare = 1. Sem proxy nenhum (localhost direto) = 0.
TRUSTED_PROXY_HOPS=1

# Sal para pseudonimizar o IP na trilha de auditoria (LGPD: nunca gravamos o
# IP em claro). Se vazio, usa o COOKIE_SECRET. Trocar invalida a correlação
# de eventos antigos, mas não quebra nada.
AUDIT_IP_SALT=

# ---- Cookies/sessão ----
COOKIE_SECRET=             # gerado por npm run setup se vazio
SESSION_SECURE=true        # Secure + httpOnly + SameSite=Strict (use false em http local)
