# ============================================================
# StarGuard — variáveis de ambiente (exemplo)
# Copie para .env.local e ajuste. NUNCA versione .env.local.
# ============================================================

# ---- Modo demo ----
# true  -> usa fixtures, não clona repositório nem executa scanners/IA reais.
#          Ideal para focar no visual/formato ponta a ponta.
# false -> executa integrações reais (exige binários/keys configurados).
DEMO_MODE=true

# ---- Chaves de IA (headless por etapa) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GITHUB_TOKEN=

# ---- Provider/modelo default ----
AI_PROVIDER=anthropic          # anthropic | openai | google
AI_MODEL=claude-sonnet-5       # id de modelo ATUAL

# ---- Override de IA por etapa (headless por step) ----
STEP1_PROVIDER=anthropic
STEP1_MODEL=claude-sonnet-5
STEP2_PROVIDER=anthropic
STEP2_MODEL=claude-sonnet-5
STEP4_PROVIDER=anthropic
STEP4_MODEL=claude-sonnet-5

# ---- Engines de segurança (headless por etapa) ----
SAST_ENGINE=opengrep           # opengrep | semgrep | none
SCA_ENGINE=trivy               # trivy | none
DAST_ENGINE=none               # none | zap(futuro)

# ---- Engine da Fase 4 (Correção) ----
# agent (padrão) -> via principal: agente autônomo (Claude Agent SDK) que clona o
#          repo, LÊ o repositório e EDITA os arquivos (Read/Edit apenas — sem
#          execução de comandos). Exige ANTHROPIC_API_KEY.
# api   -> disparo único na Claude API (busca o arquivo inteiro e devolve corrigido).
# A API entra como fallback SILENCIOSO se o agente falhar (sem key/rede/timeout).
FIX_ENGINE=agent               # agent | api
# FIX_AGENT_MODEL=             # default: modelo da etapa refactor (STEP4_MODEL/AI_MODEL)
# FIX_AGENT_MAX_TURNS=24       # teto de passos do agente
# FIX_AGENT_BUDGET_USD=1       # teto de custo por correção
# FIX_AGENT_TIMEOUT_MS=270000  # teto de tempo de parede (< maxDuration da rota)

# Caminhos opcionais para binários (default: usa o nome no PATH)
# SEMGREP_BIN=semgrep
# OPENGREP_BIN=opengrep
# TRIVY_BIN=trivy

# ============================================================
# Segurança / Auth (obrigatório)
# ============================================================

# JWT assimétrico (RS256). Gere com: npm run setup  (grava em .env.local).
# Pode ser PEM literal OU base64 do PEM (auto-detectado). NUNCA versionar.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=starguard
JWT_AUDIENCE=starguard-web

# Argon2id (params mínimos recomendados)
ARGON_MEMORY_KIB=19456     # ~19 MB
ARGON_ITERATIONS=3
ARGON_PARALLELISM=1

# ---- Usuário demo (apenas DEMO_MODE) ----
# O hash Argon2id é derivado em runtime a partir desta senha.
DEMO_USER_EMAIL=admin@starguard.local
DEMO_USER_PASSWORD=StarGuard!2026

# ---- Rate limit ----
RATE_LIMIT_REDIS_URL=      # Redis/Upstash em prod; memória no MVP
LOGIN_RATE_LIMIT=5/15m     # tentativas por conta+IP
API_RATE_LIMIT=100/1m      # global por IP

# ---- Cookies/sessão ----
COOKIE_SECRET=             # gerado por npm run setup se vazio
SESSION_SECURE=true        # Secure + httpOnly + SameSite=Strict (use false em http local)
